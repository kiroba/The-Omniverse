.dart_tool/
.packages
.pub-cache/
.pub/
build/
**/build/
mobile/build/
ios/Pods/
android/.gradle/
.gradle/
*.apk
*.aab

# Binary Executables & Heavy Cache
*.jar
*.so
*.dll
*.dylib
*.exe
*.bin
*.iso

# Python & Daemon Caches
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.env
venv/
env/

# IDE & OS Settings
.DS_Store
Thumbs.db
.idea/

# Intermediate Scratch & Out Directories
scratch/
out/
