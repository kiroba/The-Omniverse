# ==============================================================================
# THE OMNIVERSE & THE KICKBACK - CANONICAL MASTER .gitignore
# ==============================================================================

# 1. FLUTTER & NATIVE BUILD OUTPUTS
.dart_tool/
.packages
.pub-cache/
.pub/
build/
**/build/
mobile/build/
android/.gradle/
.gradle/
*.apk
*.aab
*.aar

# 2. HEAVY BINARIES (>50MB SHARED LIBS)
*.jar
*.so
*.dll
*.dylib
*.exe

# 3. LEGACY DRAFT VERSIONED SUFFIX FILES (EXCLUDES CANONICAL SCRIPTS)
*-v[0-9]*.dart
*-v[0-9]*.py
*-v[0-9]*.yaml
*-v[0-9]*.yml
*-v[0-9]*.sh
*-v[0-9]*.md

# 4. OS DUPLICATES
* (1).*
* (2).*
*.tmp
.DS_Store
Thumbs.db

# 5. PYTHON CACHES
__pycache__/
*.pyc
*.pyo
venv/
env/

# 6. IDE & LOCAL STAGING
.idea/
scratch/
out/
