{
  "name": "KickBack: The Sovereign Social Web App",
  "short_name": "KickBack",
  "description": "Serverless, P2P social universe featuring 3D Live Persona avatars, encrypted group messaging, and creator monetization.",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#0B0E14",
  "theme_color": "#00FFCC",
  "categories": ["social", "entertainment", "lifestyle"],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Live Streams",
      "short_name": "Streams",
      "description": "Jump directly into live 3D avatar stages",
      "url": "/#/live",
      "icons": [{ "src": "/icons/stream-shortcut.png", "sizes": "192x192" }]
    },
    {
      "name": "Creator Studio",
      "short_name": "Studio",
      "description": "Manage earnings, 3D cosmetics, and subscriptions",
      "url": "/#/studio",
      "icons": [{ "src": "/icons/studio-shortcut.png", "sizes": "192x192" }]
    }
  ],
  "serviceworker": {
    "src": "/kickback_pwa_service_worker.js",
    "scope": "/",
    "type": "module",
    "update_via_cache": "none"
  },
  "security_policy": {
    "subresource_integrity_enforced": true,
    "hardware_attestation_required": true,
    "zero_trust_stargate_auth": true,
    "p2p_mesh_gateway_scope": ["wss://hub.omni.network", "webrtc://mesh.omni.network"]
  }
}
